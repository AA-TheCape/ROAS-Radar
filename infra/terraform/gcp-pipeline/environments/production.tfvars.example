project_id             = "roas-radar-production"
environment            = "production"
region                 = "us-central1"
api_allowed_origins    = "https://thecapemarine.com,https://www.thecapemarine.com,https://roas-radar.thecapemarine.com"
shopify_app_base_url   = "https://roas-radar.api.thecapemarine.com"
dashboard_api_base_url = "https://roas-radar.api.thecapemarine.com"
mmm_baseline_freeze_id = ""
mmm_bayesian_freeze_id = ""

database_availability_type = "REGIONAL"
database_tier              = "db-custom-2-7680"
database_disk_size_gb      = 200

service_config = {
  api_min_instances             = 1
  api_max_instances             = 5
  api_concurrency               = 24
  worker_min_instances          = 1
  worker_max_instances          = 2
  worker_concurrency            = 4
  dashboard_min_instances       = 0
  dashboard_max_instances       = 2
  database_pool_max             = 8
  worker_database_pool_max      = 4
  ads_sync_database_pool_max    = 2
}

paused_schedulers = [
  "meta_ads_metadata",
  "google_ads_metadata",
  "mmm_bayesian",
]
