{
  "name": "roas_metadata_refresh_jobs",
  "description": "Counts campaign metadata refresh job lifecycle events.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"campaign_metadata_sync_job_lifecycle\"",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "stage": "EXTRACT(jsonPayload.stage)",
    "platform": "EXTRACT(jsonPayload.platform)",
    "worker_id": "EXTRACT(jsonPayload.workerId)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "displayName": "ROAS Radar Metadata Refresh Jobs",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting lifecycle logs." },
      { "key": "stage", "valueType": "STRING", "description": "Lifecycle stage." },
      { "key": "platform", "valueType": "STRING", "description": "Ad platform." },
      { "key": "worker_id", "valueType": "STRING", "description": "Worker id." }
    ]
  }
}
