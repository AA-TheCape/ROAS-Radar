{
  "name": "roas_metadata_refresh_jobs",
  "description": "Counts campaign metadata sync lifecycle events by stage, platform, and requester.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"campaign_metadata_sync_job_lifecycle\"",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "stage": "EXTRACT(jsonPayload.stage)",
    "platform": "EXTRACT(jsonPayload.platform)",
    "worker_id": "EXTRACT(jsonPayload.workerId)",
    "requested_by": "EXTRACT(jsonPayload.requestedBy)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "displayName": "ROAS Radar Metadata Refresh Jobs",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting the sync lifecycle event." },
      { "key": "stage", "valueType": "STRING", "description": "Lifecycle stage." },
      { "key": "platform", "valueType": "STRING", "description": "Ad platform." },
      { "key": "worker_id", "valueType": "STRING", "description": "Worker identity for the sync job." },
      { "key": "requested_by", "valueType": "STRING", "description": "Scheduler or operator source that requested the sync." }
    ]
  }
}
