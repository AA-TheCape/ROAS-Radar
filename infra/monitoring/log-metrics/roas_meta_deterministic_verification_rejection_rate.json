{
  "name": "roas_meta_deterministic_verification_rejection_rate",
  "description": "Distribution of per-job deterministic verification rejection rates.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"meta_ads_deterministic_verification_summary\"",
  "valueExtractor": "EXTRACT(jsonPayload.verificationRejectionRate)",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "trigger_source": "EXTRACT(jsonPayload.triggerSource)",
    "ad_account_id": "EXTRACT(jsonPayload.adAccountId)",
    "batch_id": "EXTRACT(jsonPayload.batchId)",
    "evidence_rejection_reason": "EXTRACT(jsonPayload.evidenceRejectionReason)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "1",
    "displayName": "ROAS Radar Meta Deterministic Verification Rejection Rate",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting verification telemetry." },
      { "key": "trigger_source", "valueType": "STRING", "description": "Why the sync ran." },
      { "key": "ad_account_id", "valueType": "STRING", "description": "Meta ad account identifier." },
      { "key": "batch_id", "valueType": "STRING", "description": "Deterministic ingestion batch identifier." },
      { "key": "evidence_rejection_reason", "valueType": "STRING", "description": "Evidence-level rejection reason, when present." }
    ]
  },
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [0, 0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 1]
    }
  }
}
