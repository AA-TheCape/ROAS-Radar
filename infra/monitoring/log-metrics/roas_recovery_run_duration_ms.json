{
  "name": "roas_recovery_run_duration_ms",
  "description": "Distribution of recovery run duration for terminal lifecycle events.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"recovery_run_lifecycle\" AND jsonPayload.stage=(\"completed\" OR \"failed\" OR \"cancelled\")",
  "valueExtractor": "EXTRACT(jsonPayload.durationMs)",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "job_type": "EXTRACT(jsonPayload.jobType)",
    "stage": "EXTRACT(jsonPayload.stage)",
    "status": "EXTRACT(jsonPayload.status)",
    "mode": "EXTRACT(jsonPayload.mode)",
    "dry_run": "EXTRACT(jsonPayload.dryRun)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms",
    "displayName": "ROAS Radar Recovery Run Duration",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting the recovery telemetry." },
      { "key": "job_type", "valueType": "STRING", "description": "Recovery job type." },
      { "key": "stage", "valueType": "STRING", "description": "Terminal lifecycle stage." },
      { "key": "status", "valueType": "STRING", "description": "Persisted recovery run status." },
      { "key": "mode", "valueType": "STRING", "description": "manual, scheduled, or automatic." },
      { "key": "dry_run", "valueType": "STRING", "description": "Whether side effects were suppressed." }
    ]
  },
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [60000, 300000, 900000, 1800000, 3600000, 7200000, 14400000]
    }
  }
}
