{
  "name": "roas_meta_deterministic_ingestion_latency_ms",
  "description": "Distribution of Meta deterministic ingestion job duration in milliseconds.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"meta_ads_deterministic_sync_job_completed\"",
  "valueExtractor": "EXTRACT(jsonPayload.durationMs)",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "trigger_source": "EXTRACT(jsonPayload.triggerSource)",
    "ad_account_id": "EXTRACT(jsonPayload.adAccountId)",
    "batch_id": "EXTRACT(jsonPayload.batchId)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms",
    "displayName": "ROAS Radar Meta Deterministic Ingestion Latency",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting deterministic ingestion telemetry." },
      { "key": "trigger_source", "valueType": "STRING", "description": "Why the sync ran." },
      { "key": "ad_account_id", "valueType": "STRING", "description": "Meta ad account identifier." },
      { "key": "batch_id", "valueType": "STRING", "description": "Deterministic ingestion batch identifier." }
    ]
  },
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [1000, 5000, 15000, 30000, 60000, 120000, 300000, 600000]
    }
  }
}
