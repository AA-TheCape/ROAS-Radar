{
  "name": "roas_campaign_metadata_sync_latency_ms",
  "description": "Distribution of completed campaign metadata refresh job durations.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"campaign_metadata_sync_job_lifecycle\" AND jsonPayload.stage=\"completed\"",
  "valueExtractor": "EXTRACT(jsonPayload.durationMs)",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "platform": "EXTRACT(jsonPayload.platform)",
    "worker_id": "EXTRACT(jsonPayload.workerId)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms",
    "displayName": "ROAS Radar Campaign Metadata Sync Latency",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting lifecycle logs." },
      { "key": "platform", "valueType": "STRING", "description": "Ad platform." },
      { "key": "worker_id", "valueType": "STRING", "description": "Worker id." }
    ]
  },
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [1000, 5000, 15000, 30000, 60000, 180000, 300000, 900000]
    }
  }
}
