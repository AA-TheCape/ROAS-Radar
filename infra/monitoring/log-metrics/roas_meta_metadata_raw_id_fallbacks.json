{
  "name": "roas_meta_metadata_raw_id_fallbacks",
  "description": "Distribution of unresolved Meta metadata raw-ID fallbacks emitted by reporting lookup logs.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"meta_metadata_raw_id_fallback\"",
  "valueExtractor": "EXTRACT(jsonPayload.unresolvedCount)",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "resolution_scope": "EXTRACT(jsonPayload.resolutionScope)",
    "platform": "EXTRACT(jsonPayload.platform)",
    "source": "EXTRACT(jsonPayload.source)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "1",
    "displayName": "ROAS Radar Meta Metadata Raw ID Fallbacks",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting raw-ID fallback telemetry." },
      { "key": "resolution_scope", "valueType": "STRING", "description": "Meta metadata resolution scope." },
      { "key": "platform", "valueType": "STRING", "description": "Ad platform." },
      { "key": "source", "valueType": "STRING", "description": "Reporting source filter." }
    ]
  },
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [0, 1, 5, 10, 25, 50, 100, 250]
    }
  }
}
