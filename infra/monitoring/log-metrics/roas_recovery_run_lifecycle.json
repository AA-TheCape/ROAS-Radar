{
  "name": "roas_recovery_run_lifecycle",
  "description": "Counts recovery run lifecycle events emitted by automatic and manual recovery jobs.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"recovery_run_lifecycle\"",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "job_type": "EXTRACT(jsonPayload.jobType)",
    "stage": "EXTRACT(jsonPayload.stage)",
    "status": "EXTRACT(jsonPayload.status)",
    "mode": "EXTRACT(jsonPayload.mode)",
    "dry_run": "EXTRACT(jsonPayload.dryRun)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "displayName": "ROAS Radar Recovery Run Lifecycle",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting the recovery telemetry." },
      { "key": "job_type", "valueType": "STRING", "description": "Recovery job type." },
      { "key": "stage", "valueType": "STRING", "description": "Run lifecycle stage." },
      { "key": "status", "valueType": "STRING", "description": "Persisted recovery run status." },
      { "key": "mode", "valueType": "STRING", "description": "manual, scheduled, or automatic." },
      { "key": "dry_run", "valueType": "STRING", "description": "Whether side effects were suppressed." }
    ]
  }
}
