{
  "name": "roas_campaign_metadata_unresolved_count",
  "description": "Distribution of unresolved campaign metadata counts emitted by resolution coverage logs.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"campaign_metadata_resolution_coverage\"",
  "valueExtractor": "EXTRACT(jsonPayload.unresolvedCount)",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "resolution_scope": "EXTRACT(jsonPayload.resolutionScope)",
    "platform": "EXTRACT(jsonPayload.platform)",
    "entity_type": "EXTRACT(jsonPayload.entityType)",
    "source": "EXTRACT(jsonPayload.source)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "1",
    "displayName": "ROAS Radar Campaign Metadata Unresolved Count",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting the coverage event." },
      { "key": "resolution_scope", "valueType": "STRING", "description": "Campaign metadata resolution scope." },
      { "key": "platform", "valueType": "STRING", "description": "Ad platform." },
      { "key": "entity_type", "valueType": "STRING", "description": "Resolved entity type." },
      { "key": "source", "valueType": "STRING", "description": "Source field used for resolution diagnostics." }
    ]
  },
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [0, 1, 5, 10, 25, 50, 100, 250]
    }
  }
}
