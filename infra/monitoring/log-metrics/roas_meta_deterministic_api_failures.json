{
  "name": "roas_meta_deterministic_api_failures",
  "description": "Counts failed Meta deterministic Insights API requests.",
  "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"meta_ads_api_request_failed\" AND jsonPayload.transactionSource=\"meta_ads_deterministic_insights\"",
  "labelExtractors": {
    "service": "EXTRACT(jsonPayload.service)",
    "status_class": "EXTRACT(jsonPayload.statusClass)",
    "ad_account_id": "EXTRACT(jsonPayload.adAccountId)",
    "batch_id": "EXTRACT(jsonPayload.batchId)"
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "displayName": "ROAS Radar Meta Deterministic API Failures",
    "labels": [
      { "key": "service", "valueType": "STRING", "description": "Service emitting API telemetry." },
      { "key": "status_class", "valueType": "STRING", "description": "HTTP status class." },
      { "key": "ad_account_id", "valueType": "STRING", "description": "Meta ad account identifier." },
      { "key": "batch_id", "valueType": "STRING", "description": "Deterministic ingestion batch identifier." }
    ]
  }
}
