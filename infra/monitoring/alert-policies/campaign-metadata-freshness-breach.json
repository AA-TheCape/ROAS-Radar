{
  "displayName": "ROAS Radar __ENVIRONMENT__ Campaign Metadata Freshness Breach",
  "documentation": {
    "content": "Campaign metadata freshness snapshots report stale entities for an extended window. Runbook: __RUNBOOK_URL_ATTRIBUTION__",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "severity": "WARNING",
  "notificationChannels": "__ALERT_NOTIFICATION_CHANNELS__",
  "conditions": [
    {
      "displayName": "Campaign metadata stale count above 0 for 30 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/roas_campaign_metadata_stale_count\" resource.type=\"cloud_run_revision\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "1800s",
        "aggregations": [
          {
            "alignmentPeriod": "1800s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ]
}
