{
  "displayName": "ROAS Radar __ENVIRONMENT__ MMM Bayesian Failures",
  "documentation": {
    "content": "The Bayesian MMM Cloud Run job failed. Inspect `mmm_bayesian_job_lifecycle` logs and follow the runbook: __RUNBOOK_URL_MMM__",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "severity": "ERROR",
  "notificationChannels": __ALERT_NOTIFICATION_CHANNELS__,
  "conditions": [
    {
      "displayName": "Bayesian MMM failure emitted",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/roas_mmm_bayesian_jobs\" resource.type=\"cloud_run_revision\" metric.labels.stage=\"failed\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "3600s",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ]
}
